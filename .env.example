# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# Admin area (single shared password for v1; no user accounts yet)
ADMIN_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -hex 32`. Changing it (or the password) signs everyone out.
ADMIN_SESSION_SECRET=

# Book research agent (Claude). Without it, the admin works but the agent buttons show an error.
ANTHROPIC_API_KEY=

# Catalog storage. Leave unset locally: admin edits are written to data/books.json.
# On Vercel, connect a Blob store to the project and this is set for you.
BLOB_READ_WRITE_TOKEN=
